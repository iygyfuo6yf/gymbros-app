generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String
  provider         String
  providerSubject  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  profile          UserProfile?
  mealLogs         MealLog[]
  workoutRoutines  WorkoutRoutine[]
  setLogs          WorkoutSetLog[]
}

model UserProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  age               Int
  sex               String
  weightKg          Float
  heightCm          Float
  activityLevel     String
  goal              String
  dailyCalories     Int
  proteinGrams      Int
  carbsGrams        Int
  fatsGrams         Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MealLog {
  id                String   @id @default(cuid())
  userId            String
  mealName          String
  calories          Int
  proteinGrams      Int
  carbsGrams        Int
  fatsGrams         Int
  confidence        Float
  source            String
  consumedAt        DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exercise {
  id           String @id @default(cuid())
  name         String
  muscleGroup  String
  equipment    String
}

model WorkoutRoutine {
  id          String         @id @default(cuid())
  userId      String
  name        String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries     RoutineEntry[]
}

model RoutineEntry {
  id          String         @id @default(cuid())
  routineId   String
  exerciseId  String
  repRange    String
  orderIndex  Int
  routine     WorkoutRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
}

model WorkoutSetLog {
  id          String   @id @default(cuid())
  userId      String
  exerciseId  String
  reps        Int
  weightKg    Float
  repRange    String
  performedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Gym {
  id          String @id @default(cuid())
  name        String
  city        String
  promoted    Boolean @default(false)
  rating      Float
}
