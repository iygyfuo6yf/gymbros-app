{
  "name": "@gymbros/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "DATABASE_URL=file:./dev.db JWT_SECRET=dev_jwt_secret_replace_me_12345 sh -c 'prisma migrate deploy && prisma generate && vitest run'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "seed": "tsx src/seed/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "cors": "2.8.5",
    "express": "4.19.2",
    "express-rate-limit": "7.4.1",
    "jsonwebtoken": "9.0.2",
    "uuid": "11.0.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.1",
    "@types/supertest": "6.0.2",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
